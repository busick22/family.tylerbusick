{
  "name": "family",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Family Hub — meals, planner, kids, and routines for the family tablet.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "test": "npm run test:unit && npm run test:components",
    "test:rules": "firebase emulators:exec --config firebase.wishlists.json --only firestore --project demo-family-wishes \"node --test tests/wishLists.rules.test.js tests/workCompletion.rules.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/wishLists.test.js tests/planning.test.js",
    "test:components": "vitest run"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.5",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.0"
  }
}
